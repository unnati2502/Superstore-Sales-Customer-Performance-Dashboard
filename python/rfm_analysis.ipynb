import pandas as pd
import sqlite3

conn = sqlite3.connect("superstore.db")
df = pd.read_sql_query("SELECT * FROM orders", conn)
conn.close()

print(df.shape)
print(df.dtypes)
df.head()

# Nulls
print(df.isnull().sum())

# Duplicates
print("Duplicate rows:", df.duplicated().sum())

# Convert Order Date to actual datetime
df["Order Date"] = pd.to_datetime(df["Order Date"])

# Quick range check
print(df["Order Date"].min(), df["Order Date"].max())


import datetime as dt

# Set a reference "snapshot" date (day after the most recent order in the dataset)
snapshot_date = df["Order Date"].max() + dt.timedelta(days=1)

rfm = df.groupby("Customer Name").agg({
    "Order Date": lambda x: (snapshot_date - x.max()).days,   # Recency
    "Order ID": "nunique",                                     # Frequency
    "Sales": "sum"                                              # Monetary
}).reset_index()

rfm.columns = ["Customer Name", "Recency", "Frequency", "Monetary"]
rfm.head()

rfm["R_score"] = pd.qcut(rfm["Recency"], 4, labels=[4,3,2,1]).astype(str)
rfm["F_score"] = pd.qcut(rfm["Frequency"].rank(method="first"), 4, labels=[1,2,3,4]).astype(str)
rfm["M_score"] = pd.qcut(rfm["Monetary"], 4, labels=[1,2,3,4]).astype(str)

rfm["RFM_Score"] = rfm["R_score"] + rfm["F_score"] + rfm["M_score"]
rfm.head()

def segment_customer(row):
    if row["R_score"] == '4' and row["F_score"] == '4' and row["M_score"] == '4':
        return "Champions"
    elif row["R_score"] in ['3','4'] and row["F_score"] in ['3','4']:
        return "Loyal Customers"
    elif row["R_score"] in ['1','2'] and row["F_score"] in ['3','4']:
        return "At Risk"
    elif row["R_score"] == '1' and row["F_score"] == '1':
        return "Lost"
    else:
        return "Regular"

rfm["Segment"] = rfm.apply(segment_customer, axis=1)
print(rfm["Segment"].value_counts())

# Export RFM table
rfm.to_csv("rfm_segments.csv", index=False)

# Also export a cleaned/aggregated version of the main orders table if useful
df.to_csv("orders_cleaned.csv", index=False)

print("Exported files ready for Tableau.")
